# ── MightyRent API server env ──────────────────────────────────────────────────
# Copy this file to `.env` (in this /server folder) and fill in the values.
# NEVER commit the real .env — it holds the service-role key (full DB access).

# Your Supabase project URL (same as the frontend's VITE_SUPABASE_URL)
SUPABASE_URL=https://vwdlungcycfhaykxrgsq.supabase.co

# Public anon key (same as the frontend's VITE_SUPABASE_ANON_KEY).
# Used to verify each caller's login token.
SUPABASE_ANON_KEY=your-anon-key

# SECRET service-role key — Project Settings → API → service_role.
# This bypasses Row Level Security, so it must live ONLY here on the server,
# never in the frontend / browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the API listens on.
PORT=8787

# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resend API key (re_...) — used to email tenant verification codes (OTP).
# Same Resend account as the Supabase SMTP setup. Create at resend.com/api-keys.
RESEND_API_KEY=re_your_key
# Sender for OTP emails (must be a Resend-verified domain).
OTP_FROM=MightyRent <noreply@wwwrentflow.com>

# ── SMS (Africa's Talking) — tenant phone verification codes ─────────────────
# From africastalking.com → Settings → API Key. Username is your AT app name
# ("sandbox" for the test environment). AT_SENDER_ID optional (registered
# alphanumeric sender). Set AT_SANDBOX=true to use the sandbox (simulator only).
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=
AT_SANDBOX=false
# Default country code for normalising local numbers to +E.164 (Zimbabwe=263).
SMS_COUNTRY_CODE=263
