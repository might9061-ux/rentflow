# ─────────────────────────────────────────────────────────────────────────────
# RentFlow environment variables
#
# Copy this file to ".env" and fill in your values.
#
#   cp .env.example .env
#
# IMPORTANT: If you leave the Supabase variables BLANK, RentFlow runs in
# "demo mode" — a fully-functional, localStorage-backed mock backend with
# seeded data. No accounts or credentials are required to try the app.
# Fill these in to switch to a real Supabase backend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (leave blank for demo mode) ---
# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=
# Public anon key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=

# --- Africa's Talking SMS (optional; used by the OTP RPC stub) ---
# These are ONLY read by the database-side RPC / Edge Function, never the
# browser. They are listed here for documentation. In demo mode the OTP is
# printed to the browser console and surfaced in a dev toast.
# AT_USERNAME=sandbox
# AT_API_KEY=your_africastalking_api_key
# AT_SENDER_ID=RentFlow

# --- App ---
# Country dialing code used when normalising phone numbers (Zimbabwe = 263)
VITE_DEFAULT_COUNTRY_CODE=263

# --- Online payments (leave as 'demo' to simulate card / EcoCash express) ---
# Set to 'paynow' (or your gateway) once the integration in src/lib/payments.js
# is wired to real credentials held server-side.
VITE_PAYMENTS_PROVIDER=demo
# Paynow integration keys are read ONLY by the server/Edge Function, never the
# browser. Listed here for documentation:
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=

# --- AI assistant ---
# Controls the manager & tenant copilots. Three modes:
#   demo       → built-in grounded assistant (no key, answers from app data)
#   claude     → real Claude via the LOCAL /api/assistant endpoint (vite.config.js).
#                Works with `npm run dev` / `vite preview` — no Supabase needed.
#   anthropic  → real Claude via the Supabase `assistant` Edge Function (production)
VITE_AI_PROVIDER=demo
#
# For VITE_AI_PROVIDER=claude, set your key WITHOUT the VITE_ prefix so it stays
# server-side (it is read by the Vite dev server, never shipped to the browser):
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8):
# ANTHROPIC_MODEL=claude-opus-4-8
#
# For VITE_AI_PROVIDER=anthropic, the same ANTHROPIC_API_KEY is read only by the
# Edge Function (supabase secrets set ANTHROPIC_API_KEY=sk-ant-...).
